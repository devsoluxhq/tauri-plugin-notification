{
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "dist-js",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmitOnError": true,
    "outDir": "dist-js",
    "rootDir": "guest-js",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2020"
  },
  "include": ["guest-js/*.ts"]
}
